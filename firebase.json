{
  "firestore": {"rules": "firestore.rules", "indexes": "firestore.indexes.json"},
  "storage": {"rules": "storage.rules"},
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json","firestore.rules","firestore.indexes.json","storage.rules","functions/**","**/node_modules/**","**/.*"],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {"source":"**","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=(), payment=()"},{"key":"Strict-Transport-Security","value":"max-age=31536000; includeSubDomains"}]},
      {"source":"**/*.html","headers":[{"key":"Cache-Control","value":"no-cache"}]},
      {"source":"**/*.js","headers":[{"key":"Cache-Control","value":"no-cache"}]},
      {"source":"**/*.css","headers":[{"key":"Cache-Control","value":"public, max-age=3600, stale-while-revalidate=86400"}]},
      {"source":"**/*.{svg,png,jpg,jpeg,webp,woff,woff2}","headers":[{"key":"Cache-Control","value":"public, max-age=86400, stale-while-revalidate=604800"}]}
    ]
  }
}
