rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){return request.auth!=null;}
    function admin(){return signedIn()&&exists(/databases/$(database)/documents/admins/$(request.auth.uid))&&get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled==true;}
    function subscriber(){return signedIn()&&get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionStatus=='active'&&(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('expiresAt',null)==null||get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('expiresAt',null)>request.time);}
    function activePlan(planId){return planId is string&&exists(/databases/$(database)/documents/plans/$(planId))&&get(/databases/$(database)/documents/plans/$(planId)).data.active==true;}
    function validOrder(data){return data.keys().hasAll(['orderId','reference','userId','planId','amount','currency','status','createdAt'])&&data.orderId is string&&data.reference is string&&data.userId is string&&data.planId is string&&data.amount is number&&data.currency is string&&data.status=='pending';}
    match /admins/{uid}{allow read:if signedIn()&&request.auth.uid==uid;allow write:if false;}
    match /apps/{appId}{allow read:if resource.data.active==true||admin();allow create,update,delete:if admin();}
    match /appDownloads/{appId}{allow read:if admin()||subscriber();allow create,update,delete:if admin();}
    match /offers/{offerId}{allow read:if resource.data.active==true||admin();allow create,update,delete:if admin();}
    match /offerDownloads/{offerId}{allow read:if admin()||subscriber();allow create,update,delete:if admin();}
    match /iosApps/{appId}{allow read:if resource.data.active==true||admin();allow create,update,delete:if admin();}
    match /iosDownloads/{appId}{allow read:if admin()||subscriber();allow create,update,delete:if admin();}
    match /iosPlans/{planId}{allow read:if resource.data.active==true||admin();allow create,update,delete:if admin();}
    match /plans/{planId}{allow read:if resource.data.active==true||admin();allow create,update,delete:if admin();}
    match /users/{uid}{
      allow read:if signedIn()&&(request.auth.uid==uid||admin());
      allow create:if signedIn()&&request.auth.uid==uid&&request.resource.data.subscriptionStatus=='pending';
      allow update:if admin()||(
        signedIn()&&request.auth.uid==uid&&(
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullname','country','phone'])||(
            request.resource.data.activationCodeUsed is string&&
            getAfter(/databases/$(database)/documents/activationCodes/$(request.resource.data.activationCodeUsed)).data.status=='used'&&
            getAfter(/databases/$(database)/documents/activationCodes/$(request.resource.data.activationCodeUsed)).data.usedBy==request.auth.uid&&
            getAfter(/databases/$(database)/documents/activationCodes/$(request.resource.data.activationCodeUsed)).data.planId==request.resource.data.plan&&
            request.resource.data.subscriptionStatus=='active'&&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan','subscriptionStatus','startedAt','activatedAt','expiresAt','activationCodeUsed'])
          )
        )
      );
      allow delete:if admin();
    }
    match /orders/{orderId}{
      allow read:if admin()||(signedIn()&&resource.data.userId==request.auth.uid);
      allow create:if signedIn()&&request.resource.data.userId==request.auth.uid&&validOrder(request.resource.data)&&activePlan(request.resource.data.planId)&&request.resource.data.orderId==orderId&&request.resource.data.amount==get(/databases/$(database)/documents/plans/$(request.resource.data.planId)).data.price&&request.resource.data.currency==get(/databases/$(database)/documents/plans/$(request.resource.data.planId)).data.currency;
      allow update,delete:if admin();
    }
    match /activationCodes/{codeId}{
      allow read:if admin()||(signedIn()&&resource.data.status=='unused'&&(resource.data.userId==null||resource.data.userId==request.auth.uid));
      allow create:if admin()&&request.resource.data.code==codeId&&request.resource.data.status=='unused'&&request.resource.data.planId is string&&exists(/databases/$(database)/documents/plans/$(request.resource.data.planId))&&request.resource.data.durationDays==get(/databases/$(database)/documents/plans/$(request.resource.data.planId)).data.durationDays;
      allow update:if admin()||(
        signedIn()&&resource.data.status=='unused'&&request.resource.data.status=='used'&&request.resource.data.usedBy==request.auth.uid&&
        (resource.data.userId==null||resource.data.userId==request.auth.uid)&&request.resource.data.planId==resource.data.planId&&request.resource.data.durationDays==resource.data.durationDays&&request.resource.data.code==resource.data.code
      );
      allow delete:if admin();
    }
  }
}
